{% extends 'base.html.twig' %}

{% block title %}Ajouter un restaurant{% endblock %}

{% block body %}
    <h1>Ajouter un restaurant</h1>

    {{ form_start(form) }}
        {{ form_row(form.nom) }}
        {{ form_row(form.description) }}
        {{ form_row(form.adresse) }}
        {{ form_row(form.ville) }}
        <button type="submit">Créer</button>
    {{ form_end(form) }}

    <p><a href="{{ path('app_restaurant_list') }}">&larr; Retour à la liste</a></p>
{% endblock %}
