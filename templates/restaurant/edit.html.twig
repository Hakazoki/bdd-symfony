{% extends 'base.html.twig' %}

{% block title %}Modifier {{ restaurant.nom }}{% endblock %}

{% block body %}
    <h1>Modifier {{ restaurant.nom }}</h1>

    {{ form_start(form) }}
        {{ form_row(form.nom) }}
        {{ form_row(form.description) }}
        {{ form_row(form.adresse) }}
        {{ form_row(form.ville) }}
        <button type="submit">Enregistrer</button>
    {{ form_end(form) }}

    <p><a href="{{ path('app_restaurant_show', {id: restaurant.id}) }}">&larr; Retour au restaurant</a></p>
{% endblock %}
