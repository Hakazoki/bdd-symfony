{% extends 'base.html.twig' %}

{% block title %}Ajouter une région{% endblock %}

{% block body %}
    <h1>Ajouter une région</h1>

    {{ form_start(form) }}
        {{ form_row(form.nom) }}
        <button type="submit">Créer</button>
    {{ form_end(form) }}

    <p><a href="{{ path('app_region_list') }}">&larr; Retour aux régions</a></p>
{% endblock %}
