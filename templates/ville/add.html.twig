{% extends 'base.html.twig' %}

{% block title %}Ajouter une ville{% endblock %}

{% block body %}
    <h1>Ajouter une ville</h1>

    {% if not form.region.vars.choices %}
        <p>Aucune région n'existe : <a href="{{ path('app_region_add') }}">créez d'abord une région</a>.</p>
    {% endif %}

    {{ form_start(form) }}
        {{ form_row(form.nom) }}
        {{ form_row(form.region) }}
        <button type="submit">Créer</button>
    {{ form_end(form) }}

    <p><a href="{{ path('app_ville_list') }}">&larr; Retour aux villes</a></p>
{% endblock %}
